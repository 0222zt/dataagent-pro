# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，绝不要提交
DATAAGENT_API_KEY=sk-你的Key

# 供应商：siliconflow / openrouter / groq / ollama / custom
DATAAGENT_PROVIDER=siliconflow
DATAAGENT_BASE_URL=https://api.siliconflow.cn/v1/chat/completions

# 主模型 + 兜底链（默认全部是免费档）
DATAAGENT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
DATAAGENT_FALLBACK_MODELS=Qwen/Qwen3-8B,Qwen/Qwen3.5-4B,deepseek-ai/DeepSeek-R1-0528-Qwen3-8B,THUDM/GLM-4-9B-0414

# 可选调优（都有默认值）
# DATAAGENT_TEMPERATURE=0.1
# DATAAGENT_LLM_TIMEOUT=90
# DATAAGENT_LLM_MAX_RETRIES=1
# DATAAGENT_MAX_REPAIR_ATTEMPTS=2
# DATAAGENT_HISTORY_TURNS=3
# DATAAGENT_MAX_FILE_SIZE=104857600
# DATAAGENT_MAX_ROWS=200000
# DATAAGENT_EXEC_TIMEOUT=10
# DATAAGENT_MAX_DATASETS=30
# DATAAGENT_DATASET_TTL=86400
# DATAAGENT_RESULT_CACHE_TTL=1800
# DATAAGENT_RATE_LIMIT=60
# DATAAGENT_AUTH_TOKEN=
# DATAAGENT_CORS_ORIGINS=
# DATAAGENT_LOG_LEVEL=INFO
# DATAAGENT_LOG_LLM_CODE=0

# 公网演示：1 = 首屏自动载入 sample_data/demo_sales.csv
DATAAGENT_DEMO=1

# 公网访问码：留空 = 不设门禁；设置后浏览器需要输入访问码
# DATAAGENT_ACCESS_CODE=换成6位以上的随机串

# AI 生成配额（0 = 不限）：拖字段出图不消耗这里的额度
# DATAAGENT_LLM_RATE_LIMIT=3
# DATAAGENT_LLM_DAILY_LIMIT=50
